module acceptance_filter_tb;

    // Inputs
    reg clk;
    reg rst_n;
    reg [15:0] acr_reg;
    reg [15:0] amr_reg;
    reg [10:0] rx_id;
    reg rx_ready_in;

    // Outputs
    wire rx_accepted;
    wire rx_filtered;

    // DUT Instantiation
    acceptance_filter uut (
        .clk(clk),
        .rst_n(rst_n),
        .acr_reg(acr_reg),
        .amr_reg(amr_reg),
        .rx_id(rx_id),
        .rx_ready_in(rx_ready_in),
        .rx_accepted(rx_accepted),
        .rx_filtered(rx_filtered)
    );

    // Clock Generation (10ns period)
    always #5 clk = ~clk;

    initial begin
        // Initial values
        clk         = 0;
        rst_n       = 0;
        acr_reg     = 16'h0000;
        amr_reg     = 16'h0000;
        rx_id       = 11'h000;
        rx_ready_in = 0;

        //-----------------------------------------
        // TESTCASE 1 : Reset Verification
        //-----------------------------------------
        #20;
        $display("TESTCASE 1 : Reset Verification");
        $display("rx_accepted = %b, rx_filtered = %b",
                  rx_accepted, rx_filtered);

        //-----------------------------------------
        // Release Reset
        //-----------------------------------------
        rst_n = 1;
        #10;

        //-----------------------------------------
        // TESTCASE 2 : Exact ID Match
        //-----------------------------------------
        $display("TESTCASE 2 : Exact ID Match");

        acr_reg     = 16'h0555;   // 11-bit ID = 555h
        amr_reg     = 16'h0000;   // no masking
        rx_id       = 11'h555;
        rx_ready_in = 1;

        #10;
        rx_ready_in = 0;

        #10;
        $display("rx_accepted = %b, rx_filtered = %b",
                  rx_accepted, rx_filtered);

        //-----------------------------------------
        // TESTCASE 3 : Exact ID Mismatch
        //-----------------------------------------
        $display("TESTCASE 3 : Exact ID Mismatch");

        rx_id       = 11'h554;   // mismatch
        rx_ready_in = 1;

        #10;
        rx_ready_in = 0;

        #10;
        $display("rx_accepted = %b, rx_filtered = %b",
                  rx_accepted, rx_filtered);

        //-----------------------------------------
        // TESTCASE 4 : Masked Bit Ignore
        //-----------------------------------------
        $display("TESTCASE 4 : Masked Bit Ignore");

        acr_reg     = 16'h0555;
        amr_reg     = 16'h0001;   // ignore LSB
        rx_id       = 11'h554;    // differs only in LSB
        rx_ready_in = 1;

        #10;
        rx_ready_in = 0;

        #10;
        $display("rx_accepted = %b, rx_filtered = %b",
                  rx_accepted, rx_filtered);

        //-----------------------------------------
        // TESTCASE 5 : All Bits Masked
        //-----------------------------------------
        $display("TESTCASE 5 : All Bits Masked");

        amr_reg     = 16'h07FF;   // ignore all 11 bits
        rx_id       = 11'h123;    // any random ID
        rx_ready_in = 1;

        #10;
        rx_ready_in = 0;

        #10;
        $display("rx_accepted = %b, rx_filtered = %b",
                  rx_accepted, rx_filtered);

        //-----------------------------------------
        // TESTCASE 6 : rx_ready_in = 0
        //-----------------------------------------
        $display("TESTCASE 6 : rx_ready_in = 0");

        amr_reg     = 16'h0000;
        rx_id       = 11'h555;
        rx_ready_in = 0;

        #20;
        $display("rx_accepted = %b, rx_filtered = %b",
                  rx_accepted, rx_filtered);

        //-----------------------------------------
        // TESTCASE 7 : Boundary ID Test
        //-----------------------------------------
        $display("TESTCASE 7 : Boundary ID Test");

        acr_reg     = 16'h0000;
        amr_reg     = 16'h0000;
        rx_id       = 11'h000;
        rx_ready_in = 1;

        #10;
        rx_ready_in = 0;

        #10;
        $display("Lower Boundary -> accepted = %b, filtered = %b",
                  rx_accepted, rx_filtered);

        acr_reg     = 16'h07FF;
        rx_id       = 11'h7FF;
        rx_ready_in = 1;

        #10;
        rx_ready_in = 0;

        #10;
        $display("Upper Boundary -> accepted = %b, filtered = %b",
                  rx_accepted, rx_filtered);

        //-----------------------------------------
        // Finish Simulation
        //-----------------------------------------
        #20;
        $display("Simulation Completed");
        $stop;
    end

endmodule
