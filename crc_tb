`timescale 1ns / 1ps

module crc_tb;

reg clk;
reg rst_n;
reg enable;
reg clear;
reg data_in;

wire [14:0] crc_out;

crc uut (
    .clk(clk),
    .rst_n(rst_n),
    .enable(enable),
    .clear(clear),
    .data_in(data_in),
    .crc_out(crc_out)
);

always #5 clk = ~clk;

task send_bit;
input bit_in;
begin
    @(posedge clk);
    enable = 1;
    data_in = bit_in;
end
endtask


initial begin

    clk = 0;
    rst_n = 0;
    enable = 0;
    clear = 0;
    data_in = 0;

   //reset
    #20;
    rst_n = 1;
    $display("Reset Released, CRC = %h", crc_out);

    //--------------------------------
    // Send Pattern: 1101011100110101
    //--------------------------------
    clear = 1;
    @(posedge clk);
    clear = 0;

    $display("Sending data pattern...");

    send_bit(1);
    send_bit(1);
    send_bit(0);
    send_bit(1);
    send_bit(0);
    send_bit(1);
    send_bit(1);
    send_bit(1);
    send_bit(0);
    send_bit(0);
    send_bit(1);
    send_bit(1);
    send_bit(0);
    send_bit(1);
    send_bit(0);
    send_bit(1);

    @(posedge clk);
    enable = 0;

    $display("Final CRC = %h", crc_out);

    //--------------------------------
    // Clear Test
    //--------------------------------
    clear = 1;
    @(posedge clk);
    clear = 0;

    @(posedge clk);
    $display("CRC after clear = %h", crc_out);

    #20;
    $stop;

end

endmodule
